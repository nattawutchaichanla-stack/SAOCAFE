const TOTAL=SECTIONS.reduce((a,s)=>a+s.items.length,0);
let state={},evidences={},history=[];

function init(){
  state={};evidences={};
  SECTIONS.forEach((s,si)=>s.items.forEach((_,ii)=>{
    const k=`${si}-${ii}`;state[k]={val:null,note:''};evidences[k]=[];
  }));
}
function loadHist(){try{history=JSON.parse(localStorage.getItem('cc_hist')||'[]')}catch(e){history=[]}}
function saveHist(){try{localStorage.setItem('cc_hist',JSON.stringify(history))}catch(e){}}

function buildUI(){
  const c=document.getElementById('sec-container');c.innerHTML='';let no=1;
  SECTIONS.forEach((s,si)=>{
    const card=document.createElement('div');card.className='sec-card';
    const hdr=document.createElement('div');hdr.className='sec-hdr';
    hdr.innerHTML=`<div class="sec-dot" style="background:${s.color}"></div><div class="sec-ttl">${s.title}</div><span class="sec-bdg bdg-empty" id="sbdg-${si}">0/${s.items.length}</span><span style="font-size:14px;color:#ccc;transition:transform .2s" id="sch-${si}">▼</span>`;
    hdr.onclick=()=>{const b=document.getElementById(`sb-${si}`),ch=document.getElementById(`sch-${si}`),open=b.style.display!=='none';b.style.display=open?'none':'block';ch.style.transform=open?'':'rotate(180deg)'};
    card.appendChild(hdr);
    const body=document.createElement('div');body.className='sec-body';body.id=`sb-${si}`;
    s.items.forEach((item,ii)=>{
      const k=`${si}-${ii}`;
      const row=document.createElement('div');row.className='chk-row';
      row.innerHTML=`<div class="chk-no">${no}</div><div class="chk-main"><div class="chk-txt">${item.t}</div>${(si===4&&ii<7)?`<div style="margin:4px 0"><img src="${MENU_IMGS[ii]}" style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:2px solid #C9A84C"></div>`:''} ${(item.img!==undefined)?`<div style="margin:4px 0;display:flex;align-items:center;gap:8px"><img src="${INGR_IMGS[item.img]}" style="width:70px;height:70px;object-fit:cover;border-radius:8px;border:2px solid #2E7D32"><span style="font-size:10px;color:#2E7D32;font-weight:600">${INGR_NAMES[item.img]}</span></div>`:''} ${item.r?`<div class="chk-recipe">📋 ข้อมูล: ${item.r}</div>`:''}</div><div class="chk-btns"><button class="cbtn" id="bp-${k}" onclick="setVal(${si},${ii},'P')">P</button><button class="cbtn" id="bf-${k}" onclick="setVal(${si},${ii},'F')">F</button><button class="cbtn" id="bn-${k}" onclick="setVal(${si},${ii},'NA')">N/A</button></div>`;
      body.appendChild(row);
      const ex=document.createElement('div');ex.className='extra';ex.id=`ex-${k}`;
      ex.innerHTML=`<textarea class="note-inp" rows="1" placeholder="หมายเหตุ..." id="note-${k}" oninput="state['${k}'].note=this.value"></textarea><div class="upload-zone"><label class="upload-label" for="uinp-${k}">📷 แนบรูปหลักฐาน<span class="ecnt" id="ecnt-${k}"></span></label><input type="file" id="uinp-${k}" accept="image/*" multiple onchange="addEvid('${k}',this)"></div><div class="thumbs" id="thumbs-${k}"></div>`;
      body.appendChild(ex);no++;
    });
    card.appendChild(body);c.appendChild(card);
  });
  document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
  document.getElementById('cnt-u').textContent=TOTAL;
}

function setVal(si,ii,val){
  const k=`${si}-${ii}`;state[k].val=state[k].val===val?null:val;const v=state[k].val;
  ['P','F','NA'].forEach(t=>{const b=document.getElementById(`b${t[0].toLowerCase()}-${k}`);if(b)b.className='cbtn'+(v===t?` ${t==='P'?'p':t==='F'?'f':'n'}-on`:'')});
  const ex=document.getElementById(`ex-${k}`);if(ex)ex.style.display=v!==null?'flex':'none';
  updateStats();
}
function addEvid(k,inp){Array.from(inp.files).forEach(f=>{const r=new FileReader();r.onload=e=>{evidences[k].push({name:f.name,data:e.target.result});renderThumbs(k);updateEvidCount()};r.readAsDataURL(f)});inp.value=''}
function renderThumbs(k){const c=document.getElementById(`thumbs-${k}`),cnt=document.getElementById(`ecnt-${k}`);if(!c)return;c.innerHTML=evidences[k].map((ev,i)=>`<div class="thumb"><img src="${ev.data}"><button class="thumb-del" onclick="evidences['${k}'].splice(${i},1);renderThumbs('${k}');updateEvidCount()">✕</button></div>`).join('');if(cnt)cnt.textContent=evidences[k].length>0?` (${evidences[k].length})`:''}
function updateEvidCount(){document.getElementById('cnt-ev').textContent=Object.values(evidences).reduce((a,arr)=>a+arr.length,0)}

function updateStats(){
  let p=0,f=0,n=0,u=0;Object.values(state).forEach(s=>{if(s.val==='P')p++;else if(s.val==='F')f++;else if(s.val==='NA')n++;else u++});
  const tot=p+f,pct=tot>0?Math.round(p/tot*100):null;
  document.getElementById('cnt-p').textContent=p;document.getElementById('cnt-f').textContent=f;document.getElementById('cnt-n').textContent=n;document.getElementById('cnt-u').textContent=u;
  const pEl=document.getElementById('score-pct'),rb=document.getElementById('result-badge');
  if(pct!==null){pEl.textContent=pct+'%';pEl.style.color=pct>=80?'#2E7D32':'#D32F2F';rb.textContent=pct>=80?'PASS':'FAIL';rb.className='rbadge '+(pct>=80?'rb-pass':'rb-fail')}
  else{pEl.textContent='—';pEl.style.color='#D32F2F';rb.textContent='รอผล';rb.className='rbadge rb-pend'}
  const prog=Math.round((p+f+n)/TOTAL*100);document.getElementById('prog-fill').style.width=prog+'%';document.getElementById('prog-txt').textContent=prog+'%';
  SECTIONS.forEach((s,si)=>{let done=0;s.items.forEach((_,ii)=>{if(state[`${si}-${ii}`].val!==null)done++});const b=document.getElementById(`sbdg-${si}`);b.textContent=`${done}/${s.items.length}`;b.className='sec-bdg '+(done===s.items.length?'bdg-done':done>0?'bdg-part':'bdg-empty')});
  const ct=document.getElementById('cover-total');const cp=document.getElementById('cover-pass');const cf=document.getElementById('cover-fail');const cs=document.getElementById('cover-score');
  if(ct)ct.textContent=TOTAL;if(cp)cp.textContent=p;if(cf)cf.textContent=f;
  if(cs)cs.textContent=pct!==null?pct+'%':'—';
}

function handleSave(){
  const u=parseInt(document.getElementById('cnt-u').textContent);if(u>0){showToast(`ยังมี ${u} รายการที่ยังไม่กรอก`);return}
  const branch=document.getElementById('f-branch').value||'ไม่ระบุ',code=document.getElementById('f-code').value||'—',date=document.getElementById('f-date').value,auditor=document.getElementById('f-auditor').value||'—',manager=document.getElementById('f-manager').value||'—',round=document.getElementById('f-round').value||'—';
  let p=0,f=0,n=0;
  const sections=SECTIONS.map((s,si)=>{let sp=0,sf=0,sn=0;const fails=[];s.items.forEach((item,ii)=>{const k=`${si}-${ii}`,v=state[k].val,note=state[k].note,imgs=(evidences[k]||[]).map(e=>e.data);if(v==='P')sp++;else if(v==='F'){sf++;fails.push({item:item.t,note,images:imgs})}else sn++;});p+=sp;f+=sf;n+=sn;return{title:s.title,color:s.color,p:sp,f:sf,n:sn,total:s.items.length,fails}});
  const pct=Math.round(p/(p+f)*100),totalEvs=Object.values(evidences).reduce((a,arr)=>a+arr.length,0);
  history.unshift({id:Date.now(),branch,code,date,auditor,manager,round,p,f,n,pct,result:pct>=80?'PASS':'FAIL',sections,evidenceCount:totalEvs});
  saveHist();showToast(`✅ บันทึก — ${branch} คะแนน ${pct}% (${pct>=80?'PASS':'FAIL'})`);document.getElementById('hist-cnt').textContent=history.length;
  setTimeout(()=>{init();buildUI();updateStats();updateEvidCount()},1800);
}

function handleExport(){
  const branch=document.getElementById('f-branch').value||'สาขา',date=document.getElementById('f-date').value||'',auditor=document.getElementById('f-auditor').value||'—',manager=document.getElementById('f-manager').value||'—';
  let p=0,f=0,n=0;Object.values(state).forEach(s=>{if(s.val==='P')p++;else if(s.val==='F')f++;else if(s.val==='NA')n++});
  const tot=p+f,pct=tot>0?Math.round(p/tot*100):0,result=pct>=80?'PASS':'FAIL';
  const totalEvs=Object.values(evidences).reduce((a,arr)=>a+arr.length,0);
  let rows='';let no=1;
  SECTIONS.forEach((s,si)=>{
    rows+=`<tr><td colspan="5" style="background:${s.color};color:#fff;font-weight:bold;padding:6px 8px;font-size:12px">${s.title}</td></tr>`;
    s.items.forEach((item,ii)=>{const k=`${si}-${ii}`,v=state[k].val,note=state[k].note,evs=evidences[k]||[];const bg=no%2===0?'#f9f9f9':'#fff';const imgs=evs.map(e=>`<img src="${e.data}" style="width:38px;height:38px;object-fit:cover;border-radius:4px;margin:1px">`).join('');rows+=`<tr style="background:${bg}"><td style="padding:5px 8px;font-size:11px;color:#888">${no}</td><td style="padding:5px 8px;font-size:11px">${item.t}${item.r?`<br><span style="font-size:9px;color:#C9A84C">📋 ${item.r}</span>`:''}</td><td style="text-align:center;font-weight:bold;color:${v==='P'?'#2E7D32':v==='F'?'#D32F2F':'#888'}">${v==='P'?'✓':v==='F'?'✗':v==='NA'?'—':''}</td><td style="padding:5px 8px;font-size:10px;color:#666">${note||''}</td><td style="padding:4px">${imgs}</td></tr>`;no++});
  });
  const html=`<!DOCTYPE html><html><head><meta charset="utf-8"><title>ใบตรวจ ชาวคาเฟ่ - ${branch}</title><style>body{font-family:sans-serif;margin:0;padding:20px;font-size:12px}h1{font-size:18px;color:#C9A84C}table{width:100%;border-collapse:collapse}th{background:#1A1A1A;color:#fff;padding:7px 8px;text-align:left;font-size:11px}td{border-bottom:1px solid #f0f0f0;vertical-align:middle}.sig{display:flex;gap:40px;margin-top:20px;padding-top:14px;border-top:1px solid #eee}.sig-line{border-top:1px solid #333;margin-top:22px;padding-top:4px;font-size:10px;color:#888}@media print{body{padding:10px}}</style></head><body><h1>ชาวคาเฟ่ — ใบตรวจสอบมาตรฐานสาขา</h1><div style="display:flex;align-items:center;gap:14px;background:#f5f5f5;padding:10px 14px;border-radius:8px;margin:12px 0"><span style="font-size:26px;font-weight:bold;color:${pct>=80?'#2E7D32':'#D32F2F'}">${pct}%</span><span style="background:${pct>=80?'#E8F5E9':'#FFEBEE'};color:${pct>=80?'#2E7D32':'#D32F2F'};padding:3px 12px;border-radius:20px;font-weight:bold">${result}</span><span style="font-size:11px;color:#666">ผ่าน ${p} · ไม่ผ่าน ${f} · N/A ${n} · รูป ${totalEvs}</span></div><div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:12px"><div style="border:1px solid #eee;border-radius:6px;padding:7px 10px"><span style="font-size:10px;color:#888;display:block">สาขา</span><b>${branch}</b></div><div style="border:1px solid #eee;border-radius:6px;padding:7px 10px"><span style="font-size:10px;color:#888;display:block">วันที่ตรวจ</span><b>${date}</b></div><div style="border:1px solid #eee;border-radius:6px;padding:7px 10px"><span style="font-size:10px;color:#888;display:block">ผู้ตรวจ</span><b>${auditor}</b></div></div><table><thead><tr><th style="width:28px">ที่</th><th>รายการตรวจสอบ</th><th style="width:40px;text-align:center">ผล</th><th>หมายเหตุ</th><th style="width:100px">หลักฐาน</th></tr></thead><tbody>${rows}</tbody></table><div class="sig"><div style="flex:1"><div class="sig-line">ลายมือชื่อผู้ตรวจ</div></div><div style="flex:1"><div class="sig-line">ลายมือชื่อผู้จัดการสาขา</div></div></div></body></html>`;
  const blob=new Blob([html],{type:'text/html'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`ชาวคาเฟ่_audit_${branch}_${date}.html`;document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(url);
  showToast('ดาวน์โหลดเรียบร้อย — กด Ctrl+P บันทึกเป็น PDF');
}

function handleReset(){if(!confirm('ล้างข้อมูลทั้งหมด?'))return;init();buildUI();updateStats();updateEvidCount()}

function renderHist(){
  const el=document.getElementById('hist-list');document.getElementById('hist-cnt').textContent=history.length;
  if(!history.length){el.innerHTML='<div class="empty">📋<br>ยังไม่มีประวัติ</div>';return}
  el.innerHTML='';
  history.forEach((r,idx)=>{
    const tot=r.p+r.f,pBar=tot>0?Math.round(r.p/tot*100):0,fBar=tot>0?Math.round(r.f/tot*100):0;
    const card=document.createElement('div');card.className='hist-card';
    card.innerHTML=`<div class="hist-top"><div><div class="hist-branch">${r.branch} <span style="font-size:11px;color:#999;font-weight:400">${r.code}</span></div><div class="hist-meta">${r.date} · ผู้ตรวจ: ${r.auditor} · ${r.round}</div><div style="margin-top:5px;display:flex;gap:6px;align-items:center"><span class="rbadge ${r.result==='PASS'?'rb-pass':'rb-fail'}">${r.result}</span>${r.evidenceCount>0?`<span style="font-size:10px;color:#1565C0;background:#E3F2FD;padding:2px 7px;border-radius:10px;font-weight:600">📷 ${r.evidenceCount} รูป</span>`:''}</div></div><div style="text-align:right"><div class="hist-score ${r.result==='PASS'?'pass':'fail'}">${r.pct}%</div><div style="font-size:10px;color:#999">P:${r.p} F:${r.f}</div><button class="del-btn" onclick="history.splice(${idx},1);saveHist();renderHist()">🗑</button></div></div><div class="hbar-row"><div style="font-size:10px;color:#2E7D32;min-width:26px">P${r.p}</div><div class="hbar-wrap"><div class="hbar-fill" style="background:#4CAF50;width:${pBar}%"></div></div><div style="font-size:10px;color:#D32F2F;min-width:26px">F${r.f}</div><div class="hbar-wrap"><div class="hbar-fill" style="background:#D32F2F;width:${fBar}%"></div></div></div><div id="hdet-${idx}" style="display:none;margin-top:10px;border-top:1px solid #f5f5f5;padding-top:10px">${r.sections.map(s=>`<div class="det-section"><span>${s.title}</span><span>ผ่าน ${s.p}/${s.total} · ไม่ผ่าน ${s.f}</span></div>`).join('')}${r.sections.some(s=>s.fails&&s.fails.length)?`<div style="margin-top:8px"><b style="font-size:11px;color:#888">รายการที่ไม่ผ่าน</b><div style="margin-top:4px">${r.sections.flatMap(s=>(s.fails||[]).map(f=>`<div class="det-fail">${f.item}${f.note?` (${f.note})`:''}<div class="det-imgs">${(f.images||[]).map(img=>`<img src="${img}">`).join('')}</div></div>`)).join('')}</div></div>`:''}</div><button class="expand-btn" id="ebtn-${idx}" onclick="const d=document.getElementById('hdet-${idx}'),b=document.getElementById('ebtn-${idx}'),o=d.style.display!=='none';d.style.display=o?'none':'block';b.textContent=o?'▼ ดูรายละเอียด':'▲ ซ่อน'">▼ ดูรายละเอียด</button>`;
    el.appendChild(card);
  });
}

function switchTab(t){
  document.getElementById('pane-form').style.display=t==='form'?'block':'none';
  document.getElementById('pane-hist').style.display=t==='hist'?'block':'none';
  document.getElementById('tab-form').className='ptab'+(t==='form'?' active':'');
  document.getElementById('tab-hist').className='ptab'+(t==='hist'?' active':'');
  if(t==='hist')renderHist();
}
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000)}

loadHist();init();buildUI();updateStats();document.getElementById('hist-cnt').textContent=history.length;
