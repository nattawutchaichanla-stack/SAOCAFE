  <div style="font-size:11px;color:#888">คู่มือการตรวจสอบคุณภาพแฟรนไชส์ · QA-CC-001</div>
  <div style="display:flex;justify-content:center;gap:16px;margin-top:14px">
    <div style="text-align:center"><div style="font-size:18px;font-weight:600;color:#C9A84C" id="cover-total">—</div><div style="font-size:10px;color:#999;margin-top:2px">รายการทั้งหมด</div></div>
    <div style="width:1px;background:#eee"></div>
    <div style="text-align:center"><div style="font-size:18px;font-weight:600;color:#2E7D32" id="cover-pass">0</div><div style="font-size:10px;color:#999;margin-top:2px">ผ่าน</div></div>
    <div style="width:1px;background:#eee"></div>
    <div style="text-align:center"><div style="font-size:18px;font-weight:600;color:#D32F2F" id="cover-fail">0</div><div style="font-size:10px;color:#999;margin-top:2px">ไม่ผ่าน</div></div>
    <div style="width:1px;background:#eee"></div>
    <div style="text-align:center"><div style="font-size:18px;font-weight:600;color:#1A1A1A" id="cover-score">—</div><div style="font-size:10px;color:#999;margin-top:2px">คะแนน</div></div>
  </div>
</div>
  <div class="tab-bar">
    <button class="ptab active" id="tab-form" onclick="switchTab('form')">📝 กรอกใบตรวจ</button>
    <button class="ptab" id="tab-hist" onclick="switchTab('hist')">📊 ประวัติ (<span id="hist-cnt">0</span>)</button>
  </div>

  <div id="pane-form">
    <div class="top-card">
      <div><h2>ชาวคาเฟ่ — ใบตรวจสอบมาตรฐานสาขา</h2><p>ร้านเครื่องดื่ม · QA-CC-001</p></div>
      <div class="prog-wrap"><div class="prog-bar"><div class="prog-fill" id="prog-fill" style="width:0%"></div></div><div class="prog-txt" id="prog-txt">0%</div></div>
    </div>
    <div class="info-grid">
      <div class="info-field"><label>ชื่อสาขา</label><input type="text" placeholder="กรอกชื่อสาขา" id="f-branch"></div>
      <div class="info-field"><label>รหัสสาขา</label><input type="text" placeholder="RS-001" id="f-code"></div>
      <div class="info-field"><label>วันที่ตรวจ</label><input type="date" id="f-date"></div>
      <div class="info-field"><label>ผู้ตรวจ</label><input type="text" placeholder="ชื่อผู้ตรวจ" id="f-auditor"></div>
      <div class="info-field"><label>ผู้จัดการสาขา</label><input type="text" placeholder="ชื่อผู้จัดการ" id="f-manager"></div>
      <div class="info-field"><label>รอบตรวจ</label><input type="text" placeholder="ครั้งที่ 1" id="f-round"></div>
    </div>
    <div class="sum-bar">
      <div class="sum-item"><div class="sum-dot" style="background:var(--g)"></div><div class="sum-lbl">ผ่าน</div><div class="sum-num" id="cnt-p">0</div></div>
      <div class="sum-item"><div class="sum-dot" style="background:var(--r)"></div><div class="sum-lbl">ไม่ผ่าน</div><div class="sum-num" id="cnt-f">0</div></div>
      <div class="sum-item"><div class="sum-dot" style="background:#9E9E9E"></div><div class="sum-lbl">N/A</div><div class="sum-num" id="cnt-n">0</div></div>
      <div class="sum-item"><div class="sum-dot" style="background:#ddd"></div><div class="sum-lbl">รอ</div><div class="sum-num" id="cnt-u">0</div></div>
      <div class="sum-item"><div class="sum-dot" style="background:#1565C0"></div><div class="sum-lbl">รูป</div><div class="sum-num" id="cnt-ev">0</div></div>
      <div class="sum-score">
        <div class="sum-score-num" id="score-pct">—</div>
        <div style="font-size:10px;color:#999">คะแนน</div>
        <div class="rbadge rb-pend" id="result-badge">รอผล</div>
      </div>
    </div>
    <div id="sec-container"></div>
    <div class="action-row">
      <button class="btn-red" onclick="handleSave()">💾 บันทึกผลการตรวจ</button>
      <button class="btn-sec" onclick="handleExport()">📄 Export PDF</button>
      <button class="btn-sec" onclick="handleReset()">🔄</button>
    </div>
    <div class="toast" id="toast"></div>
  </div>

  <div id="pane-hist" style="display:none">
    <div id="hist-list"></div>
  </div>
</div>

