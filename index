<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ใบตรวจสอบสาขา ชาวคาเฟ่</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--r:#D32F2F;--rd:#B71C1C;--rl:#FFEBEE;--dk:#1A1A1A;--g:#4CAF50;--gl:#E8F5E9;--gd:#2E7D32;--gold:#C9A84C}
body{font-family:'Sarabun',sans-serif;background:#F5F5F5;color:#212121}
.navbar{background:var(--dk);padding:0 20px;height:52px;display:flex;align-items:center;justify-content:space-between}
.nav-logo{font-size:16px;font-weight:700;color:var(--gold);letter-spacing:1px}
.nav-sub{font-size:11px;color:#666}
.container{max-width:780px;margin:0 auto;padding:16px}
.tab-bar{display:flex;gap:4px;background:#fff;border-radius:12px;padding:4px;margin-bottom:14px;border:1px solid #eee}
.ptab{flex:1;padding:9px;text-align:center;font-size:12px;font-weight:600;border-radius:8px;cursor:pointer;color:#888;border:none;background:transparent;font-family:inherit}
.ptab.active{background:var(--dk);color:#fff}
.top-card{background:var(--dk);border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.top-card h2{font-size:14px;font-weight:600;color:var(--gold)}
.top-card p{font-size:11px;color:#888;margin-top:2px}
.prog-wrap{display:flex;align-items:center;gap:8px}
.prog-bar{width:110px;height:5px;background:rgba(255,255,255,.1);border-radius:3px;overflow:hidden}
.prog-fill{height:100%;background:var(--gold);border-radius:3px;transition:width .4s}
.prog-txt{font-size:11px;color:#aaa;min-width:30px}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px}
.info-field{background:#fff;border:1px solid #eee;border-radius:8px;padding:8px 10px}
.info-field label{font-size:10px;color:#999;display:block;margin-bottom:3px;font-weight:600}
.info-field input{width:100%;font-size:12px;border:none;background:transparent;color:#212121;outline:none;font-family:inherit}
.info-field input::placeholder{color:#ccc}
.sum-bar{background:#fff;border:1px solid #eee;border-radius:12px;padding:12px 16px;margin-bottom:14px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.sum-item{display:flex;align-items:center;gap:5px}
.sum-dot{width:7px;height:7px;border-radius:50%}
.sum-lbl{font-size:11px;color:#888}
.sum-num{font-size:13px;font-weight:600}
.sum-score{margin-left:auto;text-align:right}
.sum-score-num{font-size:22px;font-weight:700;color:var(--r)}
.rbadge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;display:inline-block;margin-top:2px}
.rb-pass{background:var(--gl);color:var(--gd)}
.rb-fail{background:var(--rl);color:var(--rd)}
.rb-pend{background:#f5f5f5;color:#888}
.sec-card{background:#fff;border:1px solid #eee;border-radius:12px;margin-bottom:8px;overflow:hidden}
.sec-hdr{padding:11px 14px;display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none}
.sec-hdr:hover{background:#fafafa}
.sec-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.sec-ttl{font-size:12px;font-weight:600;flex:1}
.sec-bdg{font-size:10px;padding:2px 7px;border-radius:10px;font-weight:600}
.bdg-done{background:var(--gl);color:var(--gd)}
.bdg-part{background:#FFF8E1;color:#E65100}
.bdg-empty{background:#f5f5f5;color:#888}
.sec-body{border-top:1px solid #f0f0f0}
.chk-row{display:flex;align-items:flex-start;padding:8px 14px;border-bottom:1px solid #f8f8f8}
.chk-row:last-child{border-bottom:none}
.chk-no{font-size:10px;color:#ccc;width:22px;flex-shrink:0;padding-top:2px}
.chk-main{flex:1;padding:0 8px}
.chk-txt{font-size:12px;color:#333;line-height:1.4}
.chk-recipe{font-size:10px;color:#888;margin-top:3px;line-height:1.6;background:#fafafa;border-radius:4px;padding:4px 6px;border-left:2px solid var(--gold)}
.chk-btns{display:flex;gap:3px;flex-shrink:0}
.cbtn{width:34px;height:27px;border-radius:6px;border:1px solid #ddd;background:transparent;font-size:11px;font-weight:600;cursor:pointer;transition:all .15s;color:#aaa;font-family:inherit}
.cbtn.p-on{background:var(--gl);border-color:var(--g);color:var(--gd)}
.cbtn.f-on{background:var(--rl);border-color:var(--r);color:var(--rd)}
.cbtn.n-on{background:#f5f5f5;border-color:#ccc;color:#888}
.extra{padding:4px 14px 10px 44px;display:none;flex-direction:column;gap:6px}
.note-inp{width:100%;font-size:11px;border:1px solid #eee;border-radius:6px;padding:6px 8px;background:#fafafa;color:#333;outline:none;resize:none;font-family:inherit}
.note-inp:focus{border-color:var(--r)}
.upload-zone{border:1.5px dashed #ddd;border-radius:8px;padding:8px 10px;cursor:pointer;background:#fafafa}
.upload-zone:hover{border-color:var(--r);background:var(--rl)}
.upload-zone input{display:none}
.upload-label{display:flex;align-items:center;gap:6px;font-size:11px;color:#888;cursor:pointer}
.ecnt{font-size:10px;color:#1565C0;font-weight:600;margin-left:4px}
.thumbs{display:flex;flex-wrap:wrap;gap:5px;margin-top:5px}
.thumb{position:relative;width:54px;height:54px;border-radius:6px;overflow:hidden;border:1px solid #eee}
.thumb img{width:100%;height:100%;object-fit:cover}
.thumb-del{position:absolute;top:1px;right:1px;width:16px;height:16px;background:rgba(0,0,0,.6);border:none;border-radius:3px;color:#fff;font-size:9px;cursor:pointer}
.action-row{display:flex;gap:8px;margin-top:4px}
.btn-red{flex:1;padding:11px;background:var(--r);color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
.btn-red:hover{background:var(--rd)}
.btn-sec{padding:11px 14px;background:#fff;color:#666;border:1px solid #ddd;border-radius:8px;font-size:12px;cursor:pointer;font-family:inherit}
.btn-sec:hover{background:#f5f5f5}
.toast{background:var(--dk);color:#fff;padding:10px 16px;border-radius:8px;font-size:12px;text-align:center;margin-top:8px;opacity:0;transition:opacity .3s;pointer-events:none}
.toast.show{opacity:1}
.hist-card{background:#fff;border:1px solid #eee;border-radius:12px;padding:14px;margin-bottom:8px}
.hist-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px}
.hist-branch{font-size:13px;font-weight:600}
.hist-meta{font-size:11px;color:#999;margin-top:2px}
.hist-score{font-size:20px;font-weight:700;text-align:right}
.hist-score.pass{color:var(--gd)} .hist-score.fail{color:var(--rd)}
.hbar-row{display:flex;gap:6px;align-items:center}
.hbar-wrap{flex:1;height:4px;background:#f0f0f0;border-radius:2px;overflow:hidden}
.hbar-fill{height:100%;border-radius:2px}
.del-btn{background:transparent;border:none;color:#ccc;cursor:pointer;font-size:13px;padding:2px 4px}
.del-btn:hover{color:var(--rd)}
.empty{text-align:center;padding:40px;color:#ccc;font-size:13px}
.expand-btn{width:100%;margin-top:8px;padding:5px;background:transparent;border:1px solid #eee;border-radius:8px;font-size:11px;color:#999;cursor:pointer;font-family:inherit}
.det-section{font-size:11px;display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid #f8f8f8;color:#555}
.det-fail{font-size:11px;color:var(--rd);padding:2px 0;display:flex;gap:4px}
.det-fail::before{content:'✗';flex-shrink:0}
.det-imgs{display:flex;flex-wrap:wrap;gap:4px;margin-top:4px}
.det-imgs img{width:48px;height:48px;object-fit:cover;border-radius:6px;border:1px solid #eee}
.menu-img{width:36px;height:36px;border-radius:6px;object-fit:cover;border:1px solid #eee;flex-shrink:0}
</style>
</head>
<body>
<nav class="navbar">
  <div class="nav-logo">ชาวคาเฟ่</div>
  <div class="nav-sub">ใบตรวจสอบมาตรฐานสาขา</div>
</nav>
<div class="container">
<div style="background:#fff;border-radius:16px;padding:28px 20px 20px;text-align:center;margin-bottom:14px;position:relative;overflow:hidden;border:1px solid #eee">
